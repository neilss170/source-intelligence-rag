APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
MAX_FILE_SIZE_MB=10
MAX_UPLOAD_FILES=10

# Postgres (with pgvector) and Redis. `docker compose up -d db redis` serves
# both on these ports; inside docker compose the api overrides them.
DATABASE_URL=postgresql+psycopg://si:si_dev_password@127.0.0.1:5433/source_intelligence
REDIS_URL=redis://127.0.0.1:6380/0
# Session cookies are HTTPS-only unless APP_ENV=development; force with true/false.
# COOKIE_SECURE=true
SESSION_DAYS=30
# Rate limits: questions per user, uploads per user, sign-in and sign-up
# attempts per address and per email.
RATE_LIMIT_QUESTIONS_PER_MINUTE=30
RATE_LIMIT_UPLOADS_PER_HOUR=20
RATE_LIMIT_AUTH_PER_15_MINUTES=10
MIN_PASSWORD_LENGTH=10

# Any OpenAI-compatible chat provider can be used.
CHAT_API_KEY=
CHAT_API_BASE_URL=https://api.openai.com/v1
CHAT_MODEL=gpt-4.1-mini
# Models to switch to when CHAT_MODEL runs out of quota, comma-separated.
# Groq meters each model separately, e.g. openai/gpt-oss-20b.
CHAT_FALLBACK_MODELS=
# Or give each model its own endpoint and key (JSON list); this overrides the
# three settings above. "kind" is "openai" (OpenAI, Groq, Ollama, vLLM) or
# "anthropic". Keys are read from the named environment variables, e.g.:
# CHAT_MODELS=[{"name":"openai/gpt-oss-120b","base_url":"https://api.groq.com/openai/v1","api_key_env":"GROQ_API_KEY"},{"name":"llama3.2:3b","base_url":"http://localhost:11434/v1"}]
CHAT_MODELS=
# For reasoning models such as gpt-oss: low, medium or high. low measured
# 1.2 s -> 0.73 s to the first token on Groq; run the evaluation before
# relying on it, since the model thinks less. Empty sends nothing.
CHAT_REASONING_EFFORT=
# Tokens one user may spend per day across all models; 0 means unlimited.
DAILY_TOKEN_BUDGET_PER_USER=200000
# Load the embedding, reranking and claim-checking models at startup, so the
# first question doesn't wait for them. /api/ready reports them.
WARM_MODELS=true
LOCAL_CHAT_MODEL=Qwen/Qwen2.5-1.5B-Instruct
# With CHAT_API_KEY set, the model writes document answers from the retrieved
# passages and cites them. false keeps the rule-based answers.
LLM_ANSWERS_ENABLED=true
# Uploads smaller than this (characters) are sent to the model whole instead
# of searched. ~4k tokens; Groq's free tier allows 8k tokens per minute.
WORKSPACE_CONTEXT_CHARS=16000
# Passages the model gets when the uploads are searched.
RETRIEVAL_TOP_K=8
# Reranker relevance (0-1) below which passages are dropped, except the
# RERANK_MIN_KEEP best, which are always kept.
RERANK_MIN_PROBABILITY=0.02
RERANK_MIN_KEEP=3
# Check each cited sentence against its source with an NLI model, and flag
# the ones it does not support.
VERIFY_CITATIONS=true
# Let the model run read-only SQL over uploaded CSV and XLSX files.
TABLE_QUERIES_ENABLED=true
# Remove emails, phone numbers and LinkedIn URLs from uploads.
REDACT_CONTACT_DETAILS=true
# OCR scanned PDFs. Needs Tesseract OCR installed and on PATH.
OCR_ENABLED=false
RERANKER_ENABLED=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Optional lightweight live web search.
TAVILY_API_KEY=
WEB_SEARCH_ENABLED=true
SEARCH_COUNTRY=india
SEARCH_MAX_RESULTS=3
